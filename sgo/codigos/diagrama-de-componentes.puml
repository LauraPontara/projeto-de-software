@startuml diagrama-de-componentes-sgo

title Diagrama de Componentes\nSistema de Gestão das Olimpíadas (SGO)

' =============================================================
' LAYOUT
' =============================================================
left to right direction

skinparam nodesep 40
skinparam ranksep 90
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #FAFAFA

' =============================================================
' ESTILO
' =============================================================
skinparam component {
  BackgroundColor #EAF4FB
  BorderColor #2176AE
  FontColor #1A1A2E
  BorderThickness 1.5
}

skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}

skinparam interface {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

skinparam queue {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
  FontColor #4A148C
}

skinparam cloud {
  BackgroundColor #F9FBE7
  BorderColor #827717
}

skinparam package {
  BorderThickness 2
  FontStyle bold
}

skinparam frame {
  BorderThickness 2
}

skinparam arrow {
  Color #616161
  FontColor #424242
  FontSize 10
}

hide stereotype

' =============================================================
' SPRITES
' =============================================================
!include <tupadr3/common>
!include <tupadr3/devicons2/postgresql>
!include <tupadr3/devicons2/redis>
!include <tupadr3/material/smartphone>
!include <tupadr3/material/computer>
!include <tupadr3/material/dns>
!include <tupadr3/material/email>
!define PNGURL https://raw.githubusercontent.com/plantuml-stdlib/gilbarbara-plantuml-sprites/master/pngs

' =============================================================
' CLIENTES
' =============================================================
package "Clientes" as CLIENTES #E3F2FD {
  MATERIAL_COMPUTER(WEB, "Web App", component, #1565C0)
  MATERIAL_SMARTPHONE(MOBILE, "Mobile App", component, #1565C0)
}

' =============================================================
' API
' =============================================================
package "Camada de API" #ffbae9 {
  MATERIAL_DNS(GW, "API Gateway", component, #a63381)
}

' =============================================================
' CONTAINER PRINCIPAL
' =============================================================
package "<img:PNGURL/docker.png>" #E8F5E9 {

' =============================================================
' MÓDULOS DE NEGÓCIO
' =============================================================
frame "Módulos de Negócio" as MOD_NEG #F1F8E9 {

together {

package "Autenticação" #FAFAFA {
  interface "IAuthAPI" as IAuthAPI
  component AUTH_MOD [
    Módulo de
    Autenticação
  ]
  IAuthAPI -- AUTH_MOD : REST
}

package "Usuários" #FAFAFA {
  interface "IUserAPI" as IUserAPI
  component USER_MOD [
    Módulo de
    Usuários
  ]
  IUserAPI -- USER_MOD : REST
}

package "Competições" #FAFAFA {
  interface "ICompAPI" as ICompAPI
  component COMP_MOD [
    Módulo de
    Competições
  ]
  ICompAPI -- COMP_MOD : REST
}

package "Inscrições" #FAFAFA {
  interface "IInscAPI" as IInscAPI
  component INSC_MOD [
    Módulo de
    Inscrições
  ]
  IInscAPI -- INSC_MOD : REST
}

package "Resultados" #FAFAFA {
  interface "IResAPI" as IResAPI
  component RES_MOD [
    Módulo de
    Resultados
  ]
  IResAPI -- RES_MOD : REST
}

package "Alocação" #FAFAFA {
  interface "IAllocAPI" as IAllocAPI
  component ALLOC_MOD [
    Módulo de
    Alocação
  ]
  IAllocAPI -- ALLOC_MOD : REST
}

package "Relatórios" #FAFAFA {
  interface "IRepAPI" as IRepAPI
  component REP_MOD [
    Módulo de
    Relatórios
  ]
  IRepAPI -- REP_MOD : REST
}

package "Notificações" #FAFAFA {
  interface "INotifAPI" as INotifAPI
  component NOTIF_MOD [
    Módulo de
    Notificações
  ]
  INotifAPI -- NOTIF_MOD : REST
}

}

}

' =============================================================
' MENSAGERIA (US04, US12, US13, US14)
' =============================================================
frame "Mensageria" as MSG #F8F0FF {

  queue "Fila de Resultados" as RES_QUEUE

  queue "Fila de Competições" as COMP_QUEUE

  queue "Fila de Inscrições" as INSC_QUEUE

  component NOTIF_WORKER [
    Worker de
    Notificações
  ]

}

' =============================================================
' INFRAESTRUTURA
' =============================================================
frame "Infraestrutura" as INFRA #FFF3E0 {

  DEV2_POSTGRESQL(DB, "PostgreSQL", database, #E65100)
  DEV2_REDIS(REDIS, "Redis", database, #DC382D)

  interface "IdbAPI" as IdbAPI
  interface "ICacheAPI" as ICacheAPI

  DB -- IdbAPI : TCP/IP
  REDIS -- ICacheAPI : TCP/IP

}

}

' =============================================================
' SERVIÇO EXTERNO DE E-MAIL
' =============================================================
MATERIAL_EMAIL(SMTP_SVC, "Serviço de E-mail", cloud, #827717)

' =============================================================
' CLIENTES → GATEWAY
' =============================================================
WEB --> GW : HTTP
MOBILE --> GW : HTTP

' =============================================================
' GATEWAY → MÓDULOS (via interfaces)
' =============================================================
GW --( IAuthAPI : REST
GW --( IUserAPI : REST
GW --( ICompAPI : REST
GW --( IInscAPI : REST
GW --( IResAPI : REST
GW --( IAllocAPI : REST
GW --( IRepAPI : REST
GW --( INotifAPI : REST

' =============================================================
' MÓDULOS → BANCO
' =============================================================
AUTH_MOD --( IdbAPI
USER_MOD --( IdbAPI
COMP_MOD --( IdbAPI
INSC_MOD --( IdbAPI
RES_MOD --( IdbAPI
ALLOC_MOD --( IdbAPI
REP_MOD --( IdbAPI
NOTIF_MOD --( IdbAPI

' =============================================================
' MÓDULOS → REDIS (sessão, token e cache)
' =============================================================
AUTH_MOD --( ICacheAPI
REP_MOD --( ICacheAPI

' =============================================================
' MÓDULOS → FILAS (publicação de eventos)
' =============================================================
COMP_MOD --> COMP_QUEUE : HTTP
INSC_MOD --> INSC_QUEUE : HTTP
RES_MOD --> RES_QUEUE : HTTP

' =============================================================
' WORKER → FILAS e SMTP
' =============================================================
NOTIF_WORKER ..> COMP_QUEUE : HTTP
NOTIF_WORKER ..> INSC_QUEUE : HTTP
NOTIF_WORKER ..> RES_QUEUE : HTTP
NOTIF_WORKER --> SMTP_SVC : HTTP

' =============================================================
' SMTP → CLIENTES (entrega das notificações)
' =============================================================
SMTP_SVC --> CLIENTES : SMTP

' =============================================================
' DEPENDÊNCIAS INTERNAS ENTRE MÓDULOS
' =============================================================
INSC_MOD ..> COMP_MOD : usa
ALLOC_MOD ..> COMP_MOD : usa
RES_MOD ..> INSC_MOD : usa
RES_MOD ..> COMP_MOD : usa
REP_MOD ..> RES_MOD : usa

' =============================================================
' LEGENDA
' =============================================================
legend bottom
  |= Notação                  |= Tipo de Relação         |= Descrição                                         |
  | A --O Interface             | Interface fornecida      | Componente A expõe um contrato (lollipop)           |
  | A --C Interface             | Interface requerida      | Componente A consome um contrato (socket)           |
  | A ..> B : usa               | Dependência direta       | Módulo depende internamente de outro módulo         |
  | A --> Fila : publish        | Publicação em fila       | Módulo publica evento na fila de mensagens          |
  | Worker ..> Fila : consume   | Consumo de fila          | Worker consome e processa eventos da fila           |
  | A --( ICacheAPI             | Cache / Sessão           | Acesso a cache ou armazenamento de sessão/token     |
endlegend

@enduml
