@startuml diagrama-de-caso-de-uso-sgo
!theme aws-orange

title Diagrama de Caso de Uso\nSistema de Gestão das Olimpíadas (SGO)

' === ESTILO ===
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam actorStyle awesome

skinparam actor {
  BackgroundColor #D6E8F7
  BorderColor #1A5276
  FontColor #1A1A2E
  FontStyle bold
}

skinparam usecase {
  BackgroundColor #EAF4FB
  BorderColor #2176AE
  FontColor #1A1A2E
  BorderThickness 1.5
}

skinparam rectangle {
  BackgroundColor #F0F7FF
  BorderColor #1A5276
  BorderThickness 2.5
  FontColor #1A5276
  FontStyle bold
  FontSize 14
}

skinparam arrow {
  Color #2176AE
  FontColor #1A5276
  FontSize 10
}

left to right direction

' === ATORES ===
actor "Administrador" as Admin #D6E8F7
actor "Juiz"          as Juiz  #D6E8F7
actor "Atleta"        as Atl   #D6E8F7
actor "Usuário"       as User  #EAF4FB

' Hierarquia: todos herdam de Usuário
Admin --|> User
Juiz  --|> User
Atl   --|> User

' === FRONTEIRA DO SISTEMA ===
rectangle "Sistema de Gestão das Olimpíadas (SGO)" {

  ' -------------------------------------------------------
  ' AUTENTICAÇÃO (US09, US10)
  ' -------------------------------------------------------
  usecase "UC01 - Fazer Login\nno Sistema" as UC01 #BBDEFB
  usecase "UC02 - Recuperar Senha" as UC02 #E3F2FD

  ' -------------------------------------------------------
  ' GESTÃO DE USUÁRIOS (US11, US19)
  ' -------------------------------------------------------
  usecase "UC03 - Gerenciar\nCadastro de Atleta" as UC03 #BBDEFB
  usecase "UC04 - Gerenciar Juiz" as UC04 #BBDEFB

  ' -------------------------------------------------------
  ' GESTÃO DE LOCAIS (US15, US16)
  ' -------------------------------------------------------
  usecase "UC05 - Cadastrar Local" as UC05 #BBDEFB
  usecase "UC06 - Consultar\nDisponibilidade de Local" as UC06 #BBDEFB

  ' -------------------------------------------------------
  ' GESTÃO DE COMPETIÇÕES (US01, US03, US04)
  ' -------------------------------------------------------
  usecase "UC07 - Cadastrar\nCompetição" as UC07 #BBDEFB
  usecase "UC08 - Alocar Local\npara Competição" as UC08 #BBDEFB
  usecase "UC09 - Cancelar\nCompetição" as UC09 #BBDEFB

  ' -------------------------------------------------------
  ' INSCRIÇÕES (US02, US04 cancelamento)
  ' -------------------------------------------------------
  usecase "UC10 - Inscrever Atleta\nem Competição" as UC10 #BBDEFB
  usecase "UC11 - Cancelar\nInscrição de Atleta" as UC11 #BBDEFB

  ' -------------------------------------------------------
  ' RESULTADOS (US05, US17)
  ' -------------------------------------------------------
  usecase "UC12 - Registrar\nResultado da Competição" as UC12 #BBDEFB
  usecase "UC13 - Editar Resultado da Competição" as UC13 #E3F2FD

  ' -------------------------------------------------------
  ' RELATÓRIOS E CONSULTAS (US06, US07, US08, US18)
  ' -------------------------------------------------------
  usecase "UC14 - Consultar Relatório\nde Medalhas" as UC14 #BBDEFB
  usecase "UC15 - Exportar Relatório\nde Medalhas" as UC15 #E3F2FD
  usecase "UC16 - Consultar Competições\npor Local" as UC16 #BBDEFB
  usecase "UC17 - Consultar Competições\nde um Atleta" as UC17 #BBDEFB

  

}

' === ASSOCIAÇÕES ATOR → CASO DE USO ===

' Autenticação — todos os usuários
User  --> UC01
User  --> UC02

' Gestão de usuários
Atl   --> UC03
Admin --> UC03
Admin --> UC04

' Gestão de locais
Admin --> UC05

' Gestão de competições
Admin --> UC07
Admin --> UC09

' Inscrições
Atl   --> UC10
Atl   --> UC11
Admin --> UC11

' Resultados
Juiz  --> UC12
Admin --> UC13

' Relatórios e consultas
User  --> UC14
User  --> UC16
User  --> UC17

' === Notificações ===
UC12 --> Atl
UC11 --> Atl
UC09 --> Atl

' === INCLUDE — chamadas obrigatórias ===
UC07 .> UC08  : <<include>>
UC08 .> UC06  : <<include>>
UC09 .> UC11  : <<include>>

' === EXTEND — chamadas opcionais/condicionais ===
UC15 .> UC14  : <<extend>>

' === LEGENDA ===
legend bottom
  |= Notação              |= Significado                              |
  | →                   | Associação (ator participa do UC)         |
  | ⇢ <<include>>         | Inclusão obrigatória (sempre executado)   |
  | ⇢ <<extend>>          | Extensão opcional (condicional)           |
  | ┄▷               | Generalização de ator (herança)           |
  |<back:#BBDEFB> Azul escuro </back>| Casos de uso principais                   |
  |<back:#E3F2FD> Azul claro  </back>| Casos de uso auxiliares / sistêmicos      |
endlegend

@enduml
