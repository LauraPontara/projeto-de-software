@startuml diagrama-de-implantacao-sgo

title Diagrama de Implantação\nSistema de Gestão das Olimpíadas (SGO)

' =============================================================
' SPRITES / LOGOS
' =============================================================
!include <logos/nginx>
!include <logos/postgresql>
!include <logos/redis>
!include <logos/react>
!include <logos/docker>
!include <logos/rabbitmq>
!include <logos/grafana>
!include <logos/prometheus>
!include <tupadr3/common>
!include <tupadr3/font-awesome/envelope>
!include <tupadr3/font-awesome/mobile>
!include <tupadr3/font-awesome/desktop>

' =============================================================
' SKINPARAM
' =============================================================
skinparam backgroundColor   #FAFAFA
skinparam shadowing         false
skinparam defaultFontName   Arial
skinparam defaultFontSize   12
skinparam roundCorner       8
skinparam defaultTextAlignment center

skinparam node {
  BackgroundColor #EAF4FB
  BorderColor     #2176AE
  FontColor       #1A1A2E
  FontStyle       bold
  BorderThickness 2
}

skinparam cloud {
  BackgroundColor #FFF9C4
  BorderColor     #F57F17
  FontColor       #5D4037
  FontStyle       bold
}

skinparam database {
  BackgroundColor #FFE0B2
  BorderColor     #E65100
  FontColor       #BF360C
  FontStyle       bold
}

skinparam component {
  BackgroundColor #C8E6C9
  BorderColor     #2E7D32
  FontColor       #1B5E20
  FontStyle       bold
}

skinparam artifact {
  BackgroundColor #DCEEFB
  BorderColor     #1A5276
  FontColor       #1A1A2E
}

skinparam frame {
  BackgroundColor #F8F9FA
  BorderColor     #1A5276
  FontColor       #1A5276
  FontStyle       bold
  BorderThickness 2
}

skinparam rectangle {
  BackgroundColor #F0F7FF
  BorderColor     #90A4AE
  FontColor       #37474F
  BorderThickness 1.5
}

skinparam arrow {
  Color     #2176AE
  FontColor #37474F
  FontSize  10
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor     #F9A825
  FontColor       #4A4A4A
}

skinparam queue {
  BackgroundColor #F3E5F5
  BorderColor     #7B1FA2
  FontColor       #4A148C
}

' =============================================================
' DISPOSITIVOS CLIENTE
' =============================================================
frame "Dispositivos Cliente" {
  node "Navegador\n<$react{scale=0.4}>\n<<Next.js>>" as BROWSER
  node "Smartphone\n<$react{scale=0.4}>\n<<React Native>>" as SMARTPHONE
}

' =============================================================
' INTERNET
' =============================================================
cloud "Internet" as INTERNET

' =============================================================
' HOSTING FRONTEND
' =============================================================
cloud "Vercel\n<<Edge Network / CDN>>" as VERCEL {
  artifact "sgo-web\n<$react{scale=0.4}>\n<<Next.js>>" as NEXT_APP
}

cloud "App Store\n/ Google Play" as STORES {
  artifact "SGO Mobile\n<$react{scale=0.4}>\n<<React Native>>" as RN_APP
}

' =============================================================
' INFRAESTRUTURA CLOUD  —  Railway
' =============================================================
frame "Infraestrutura Cloud SGO  <<Railway>>" as INFRA #E1F5FE {

  ' --- Zona de Entrada ---
  rectangle "Zona de Entrada" #EAF4FB {
    node "Load Balancer\n<$nginx{scale=0.4}>\n<<NGINX :443>>" as LB
  }

  ' --- Zona de Aplicação ---
  rectangle "Zona de Aplicação" #C8E6C9 {

    node "API Gateway\n<$nginx{scale=0.4}>\n<<NGINX :8080>>" as GW

    frame "Serviços de Negócio  <$docker{scale=0.4}>" as SVC_FRAME #F1F8E9 {
      together {
        node "Autenticação\n<<Node.js :3001>>" as AUTH_C
        node "Usuários\n<<Node.js :3002>>"     as USER_C
        node "Competições\n<<Node.js :3003>>"  as COMP_C
        node "Inscrições\n<<Node.js :3004>>"   as INSC_C
      }
      together {
        node "Resultados\n<<Node.js :3005>>"   as RES_C
        node "Alocação\n<<Node.js :3006>>"     as ALLOC_C
        node "Relatórios\n<<Node.js :3007>>"   as REP_C
        node "Notificações\n<<Node.js :3008>>" as NOTIF_C
      }
      node "Worker de Notificações\n<<Node.js>>" as WORKER_C
    }
  }

  ' --- Zona de Mensageria ---
  rectangle "Zona de Mensageria" #F3E5F5 {
    node "RabbitMQ\n<$rabbitmq{scale=0.4}>\n<<:5672 | UI :15672>>" as RABBIT
    queue "fila.resultados"  as Q_RES
    queue "fila.competicoes" as Q_COMP
    queue "fila.inscricoes"  as Q_INSC
    RABBIT -- Q_RES
    RABBIT -- Q_COMP
    RABBIT -- Q_INSC
  }

  ' --- Zona de Dados ---
  rectangle "Zona de Dados" #FFE0B2 {
    database "PostgreSQL\n<$postgresql{scale=0.4}>\n<<:5432>>" as DB
    database "Redis\n<$redis{scale=0.4}>\n<<:6379>>" as CACHE
  }

  ' --- Monitoramento ---
  rectangle "Monitoramento" #FFF9C4 {
    node "Prometheus\n<$prometheus{scale=0.4}>\n<<:9090>>" as PROM
    node "Grafana\n<$grafana{scale=0.4}>\n<<:3000>>"       as GRAF
    PROM --> GRAF : dados
  }

}

' =============================================================
' SERVIÇO EXTERNO DE E-MAIL
' =============================================================
cloud "SendGrid\n<<API de E-mail>>" as SENDGRID {
  component "Email API\n<<REST :443>>" as EMAIL_API
}

' =============================================================
' DISPOSITIVOS → INTERNET
' =============================================================
BROWSER    ..> INTERNET : HTTPS
SMARTPHONE ..> INTERNET : HTTPS

' =============================================================
' INTERNET → FRONTENDS / STORES
' =============================================================
INTERNET ..> VERCEL : HTTPS :443
INTERNET ..> STORES : download

' =============================================================
' FRONTENDS → LOAD BALANCER
' =============================================================
NEXT_APP --> LB : HTTPS :443
RN_APP   --> LB : HTTPS :443

' =============================================================
' LOAD BALANCER → GATEWAY
' =============================================================
LB --> GW : HTTP :8080

' =============================================================
' GATEWAY → SERVIÇOS  (REST)
' =============================================================
GW --> AUTH_C  : REST
GW --> USER_C  : REST
GW --> COMP_C  : REST
GW --> INSC_C  : REST
GW --> RES_C   : REST
GW --> ALLOC_C : REST
GW --> REP_C   : REST
GW --> NOTIF_C : REST

' =============================================================
' SERVIÇOS → BANCO DE DADOS  (JDBC)
' =============================================================
SVC_FRAME --> DB : JDBC :5432

' =============================================================
' SERVIÇOS → REDIS  (TCP)
' =============================================================
AUTH_C --> CACHE : TCP :6379
REP_C  --> CACHE : TCP :6379

' =============================================================
' SERVIÇOS → FILAS  (publicação AMQP)
' =============================================================
COMP_C --> Q_COMP : AMQP
INSC_C --> Q_INSC : AMQP
RES_C  --> Q_RES  : AMQP

' =============================================================
' WORKER — CONSUMO DE FILAS E ENVIO DE E-MAIL
' =============================================================
WORKER_C ..> Q_RES  : AMQP consume
WORKER_C ..> Q_COMP : AMQP consume
WORKER_C ..> Q_INSC : AMQP consume
WORKER_C --> SENDGRID : HTTPS (API)

' =============================================================
' MONITORAMENTO (Prometheus scrape)
' =============================================================
PROM ..> GW     : scrape :8080/metrics
PROM ..> DB     : scrape :9187/metrics
PROM ..> RABBIT : scrape :15692/metrics

' =============================================================
' NOTAS
' =============================================================
note right of LB
  SSL Termination.
  Distribui carga entre
  instâncias do API Gateway.
end note

note bottom of RABBIT
  3 exchanges/filas:
  resultados, competições,
  inscrições.
end note

note right of SENDGRID
  Serviço externo de
  envio de e-mails
  transacionais.
end note

' =============================================================
' LEGENDA
' =============================================================
legend bottom
  |= Elemento           |= Significado                               |
  | Cubo (node)         | Servidor / Contêiner Docker               |
  | Nuvem (cloud)       | Serviço cloud / ambiente externo          |
  | Cilindro (database) | Banco de dados / cache                    |
  | Fila (queue)        | Exchange / fila de mensagens (RabbitMQ)   |
  | Artefato            | Aplicação implantada                      |
  | ──►                | Chamada direcional com protocolo           |
  | · · ►              | Comunicação via rede externa / consume     |
  |<back:#EAF4FB> Azul claro  </back>| Servidores e contêineres    |
  |<back:#C8E6C9> Verde       </back>| Zona de aplicação            |
  |<back:#FFE0B2> Laranja     </back>| Banco de dados / cache       |
  |<back:#F3E5F5> Roxo claro  </back>| Mensageria (RabbitMQ)        |
  |<back:#FFF9C4> Amarelo     </back>| Monitoramento / cloud        |
  |<back:#E1F5FE> Azul suave  </back>| Infraestrutura Railway       |
endlegend

@enduml
