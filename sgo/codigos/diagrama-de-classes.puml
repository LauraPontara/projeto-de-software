@startuml diagrama-de-classes-sgo

title Diagrama de Classes\nSistema de Gestão das Olimpíadas (SGO)

' === CONFIGURAÇÕES GLOBAIS ===
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 8

skinparam class {
  BackgroundColor       #EAF4FB
  BorderColor           #2176AE
  FontColor             #1A1A2E
  HeaderBackgroundColor #BBDEFB
  BorderThickness       1.5
  ArrowColor            #2176AE
}

skinparam class {
  BackgroundColor<<Entity>>  #DCEEFB
  BorderColor<<Entity>>      #1A5276

  BackgroundColor<<Enum>>    #F3E5F5
  BorderColor<<Enum>>        #7B1FA2
  FontColor<<Enum>>          #4A148C

  BackgroundColor<<Log>>     #FFF8E1
  BorderColor<<Log>>         #F9A825
  FontColor<<Log>>           #4A4A00

  BackgroundColor<<Token>>   #F1F8E9
  BorderColor<<Token>>       #558B2F
  FontColor<<Token>>         #1B5E20
}

skinparam package {
  BackgroundColor #F0F7FF
  BorderColor     #1A5276
  FontColor       #1A5276
  FontStyle       bold
  BorderThickness 2
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor     #F9A825
  FontColor       #4A4A4A
}

' =============================================================
' ENUMS
' =============================================================

enum TipoUsuario <<Enum>> {
  ADMINISTRADOR
  ATLETA
  JUIZ
  PUBLICO
}

enum StatusCompeticao <<Enum>> {
  ABERTA_INSCRICOES
  EM_ANDAMENTO
  ENCERRADA
  CANCELADA
}

enum StatusInscricao <<Enum>> {
  ATIVA
  CANCELADA
}

enum TipoNotificacao <<Enum>> {
  RESULTADO_PUBLICADO
  INSCRICAO_CANCELADA
  COMPETICAO_CANCELADA
}

' =============================================================
' INTERFACES
' =============================================================

interface Cancelavel {
  + cancelar()    : void
  + isCancelado() : Boolean
}

' =============================================================
' HIERARQUIA DE USUÁRIOS
' =============================================================

class Usuario <<Entity>> {
  - id             : Long
  - nome           : String
  - email          : String
  - senha          : String
  - tipo           : TipoUsuario
  .. Getters ..
  + getId()        : Long
  + getNome()      : String
  + getEmail()     : String
  + getTipo()      : TipoUsuario
}

class Administrador <<Entity>> {
  - nivelAcesso    : Integer
  .. Getters ..
  + getNivelAcesso() : Integer
}

class Atleta <<Entity>> {
  - dataNascimento : Date
  - documento      : String
  - paisOrigem     : Pais
  .. Getters ..
  + getDataNascimento() : Date
  + getDocumento()      : String
  + getPaisOrigem()     : Pais
}

class Juiz <<Entity>> {
  - credencial     : String
  - ativo          : Boolean
  .. Getters ..
  + getCredencial() : String
  + isAtivo()       : Boolean
  == Regras de Negócio ==
  + desativar()     : void
  + reativar()      : void
}

' Herança
Usuario <|-- Administrador
Usuario <|-- Atleta
Usuario <|-- Juiz

' =============================================================
' AUTENTICAÇÃO (US09, US10)
' =============================================================

class TokenRecuperacaoSenha <<Token>> {
  - id         : Long
  - token      : String
  - expiracao  : DateTime
  - utilizado  : Boolean
  .. Getters ..
  + getToken()      : String
  + getExpiracao()  : DateTime
  + isUtilizado()   : Boolean
  == Regras de Negócio ==
  + isValido()      : Boolean
  + invalidar()     : void
}

' Token pertence a um usuário (composição — não existe sem o usuário)
Usuario "1" *-- "0..*" TokenRecuperacaoSenha : solicita >

' =============================================================
' ENTIDADES DE DOMÍNIO
' =============================================================

class Pais <<Entity>> {
  - id        : Long
  - nome      : String
  - codigoISO : String
  .. Getters ..
  + getId()        : Long
  + getNome()      : String
  + getCodigoISO() : String
  == Regras de Negócio ==
  + totalOuros()   : Integer
  + totalPratas()  : Integer
  + totalBronzes() : Integer
}

class Local <<Entity>> {
  - id         : Long
  - nome       : String
  - endereco   : String
  - capacidade : Integer
  .. Getters ..
  + getId()        : Long
  + getNome()      : String
  + getEndereco()  : String
  + getCapacidade(): Integer
  == Regras de Negócio ==
  + verificarDisponibilidade(dataHora : DateTime) : Boolean
  + getAgenda()                                   : List<Competicao>
}

class Competicao <<Entity>> {
  - id         : Long
  - modalidade : String
  - dataHora   : DateTime
  - status     : StatusCompeticao
  .. Getters ..
  + getId()         : Long
  + getModalidade() : String
  + getDataHora()   : DateTime
  + getStatus()     : StatusCompeticao
  == Regras de Negócio ==
  + isAbertaParaInscricoes() : Boolean
  + isRealizada()            : Boolean
}

class Inscricao <<Entity>> {
  - id            : Long
  - dataInscricao : Date
  - status        : StatusInscricao
  .. Getters ..
  + getId()            : Long
  + getDataInscricao() : Date
  + getStatus()        : StatusInscricao
  == Regras de Negócio ==
  + isAtiva()   : Boolean
}

class Resultado <<Entity>> {
  - id            : Long
  - dataRegistro  : DateTime
  - alteravel     : Boolean
  - primeiroLugar : Atleta
  - segundoLugar  : Atleta
  - terceiroLugar : Atleta
  .. Getters ..
  + getId()             : Long
  + getDataRegistro()   : DateTime
  + isAlteravel()       : Boolean
  + getPrimeiroLugar()  : Atleta
  + getSegundoLugar()   : Atleta
  + getTerceiroLugar()  : Atleta
  == Regras de Negócio ==
  + registrar()         : void
  + bloquearAlteracao() : void
  + permitirAlteracao() : void
}

' =============================================================
' AUDITORIA DE RESULTADO (US17)
' =============================================================

class LogAlteracaoResultado <<Log>> {
  - id                : Long
  - dataAlteracao     : DateTime
  - responsavel       : Administrador
  - descricaoAlteracao: String
  .. Getters ..
  + getId()                 : Long
  + getDataAlteracao()      : DateTime
  + getResponsavel()        : Administrador
  + getDescricaoAlteracao() : String
}

' Log pertence ao resultado (composição)
Resultado "1" *-- "0..*" LogAlteracaoResultado : auditado por >

' =============================================================
' NOTIFICAÇÕES (US12, US13, US14)
' =============================================================

class Notificacao <<Entity>> {
  - id          : Long
  - tipo        : TipoNotificacao
  - mensagem    : String
  - dataEnvio   : DateTime
  - enviada     : Boolean
  .. Getters ..
  + getId()       : Long
  + getTipo()     : TipoNotificacao
  + getMensagem() : String
  + getDataEnvio(): DateTime
  + isEnviada()   : Boolean
  == Regras de Negócio ==
  + enviar()      : void
}

' Notificação é enviada a um usuário
Notificacao "0..*" --> "1" Usuario : destinatário >

' Notificação é originada por uma competição
Notificacao "0..*" --> "0..1" Competicao : referente a >

' =============================================================
' RELACIONAMENTOS PRINCIPAIS
' =============================================================

' Atleta pertence a um país de origem
Atleta "0..*" --> "1" Pais : representa >

' Competição é realizada em um Local
Competicao "0..*" --> "1" Local : realizada em >

' Inscrição pertence a uma Competição
Competicao "1" *-- "0..*" Inscricao : contém >

' Resultado pertence a uma Competição
Competicao "1" *-- "0..1" Resultado : possui >

' Implementação da interface Cancelavel
Competicao ..|> Cancelavel
Inscricao  ..|> Cancelavel

' Inscrição referencia o Atleta inscrito
Inscricao "0..*" --> "1" Atleta : do atleta >

' Inscrição registra o País que o Atleta representa naquela competição
Inscricao "0..*" --> "1" Pais : representando >

' Resultado referencia os três atletas medalhistas
Resultado "0..*" --> "1" Atleta : posição no ranking >

' Log referencia o administrador responsável
LogAlteracaoResultado "0..*" --> "1" Administrador : realizado por >

' =============================================================
' ENUMS → ENTIDADES
' =============================================================

Usuario    --> TipoUsuario       : tipo >
Competicao --> StatusCompeticao  : status >
Inscricao  --> StatusInscricao   : status >
Notificacao --> TipoNotificacao  : tipo >

' =============================================================
' NOTAS
' =============================================================

note top of Usuario
  Classe base para todos os perfis.
  Administrador, Atleta e Juiz
  são especializações com dados próprios.
end note

' =============================================================
' LEGENDA
' =============================================================

legend bottom
  |= Notação   |= Tipo                       |= Significado                                            |
  | ───▷      | Herança (Generalização)      | Subclasse especializa a superclasse                     |
  | ───>       | Associação                   | Referência direcional entre classes                     |
  | ◆──       | Composição                   | Parte pertence ao todo; ciclo de vida dependente        |
  | ◇──       | Agregação                    | Parte associada ao todo; ciclo de vida independente     |
  | ╌╌╌▷      | Implementação de interface   | Classe concreta realiza o contrato da interface         |
  |<back:#DCEEFB>  C  </back>| Classe       | Entidade de domínio do sistema                          |
  |<back:#EAF4FB>  I  </back>| Interface    | Contrato de comportamento a ser implementado            |
  |<back:#F3E5F5>  E  </back>| Enumeração   | Conjunto fechado de valores constantes                  |
endlegend

@enduml
