@startuml comunicacao-checkin
!include _estilo-comum.puml

title Diagrama de Comunicação\nUC17 - Realizar Check-in Digital

skinparam actorStyle awesome

actor "Creator" as CRE
boundary "Gestor - Scanner (UI)" as UI
control  "Elo API"        as API
control  "CheckinService" as CHK
control  "TicketService"  as TCK
database "PostgreSQL"     as DB

CRE -> UI  : 1: abrirCheckin(eventId)
UI  -> API : 2: GET /events/{id}/checkin/summary
CRE -> UI  : 3: escanearQrCode()
UI  -> API : 4: POST /checkin {eventId, qrCode}
API -> CHK : 5: validarIngresso(eventId, qrCode)
CHK -> TCK : 6: buscarPorQrCode(qrCode)
TCK -> DB  : 6.1: buscarIngresso(qrCode)
CHK -> DB  : 7: atualizarIngresso(UTILIZADO, checkinEm)
API -> UI  : 8: resultado(validado | jaUtilizado | invalido)
UI  -> CRE : 9: exibirRetorno(verde | amarelo | vermelho)

legend bottom
  Mensagens numeradas indicam a ordem temporal das interações.
  O sufixo (ex.: 6.1) indica aninhamento dentro da mensagem 6.
endlegend

@enduml
